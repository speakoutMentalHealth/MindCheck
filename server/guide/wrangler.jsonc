{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindcheck-guide",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "GUIDE_ENABLED": "false", "GEMINI_MODEL": "gemini-3.5-flash-lite" },
  "ratelimits": [{ "name": "GUIDE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
